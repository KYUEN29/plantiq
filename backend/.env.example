# ── Plantiq AI Environment Variables Template ─────────────────────────────────

# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plantiq_db

# JWT Authentication Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application environment and cookie/CORS settings
# For production: APP_ENV=production, CORS_ORIGINS=https://plantiq.vercel.app,
# AUTH_COOKIE_SECURE=true, AUTH_COOKIE_SAMESITE=none
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
